+void Mixer::AlignLog(WaveFileWriter& writer, u64& written, u32 divisor, std::size_t incoming)
+{
+  auto& system = Core::System::GetInstance();
+  const u64 rate = FIXED_SAMPLE_RATE_DIVIDEND / divisor;
+  const double now = static_cast<double>(system.GetCoreTiming().GetTicks()) /
+                     static_cast<double>(system.GetSystemTimers().GetTicksPerSecond());
+  const u64 expected = static_cast<u64>(now * static_cast<double>(rate));
+  if (expected > written + incoming + rate / 20)
+  {
+    static const std::array<s16, 2 * 4096> zeros{};
+    u64 pad = expected - written - incoming;
+    while (pad != 0)
+    {
+      const u32 n = static_cast<u32>(std::min<u64>(pad, 4096));
+      writer.AddStereoSamplesBE(zeros.data(), n, divisor, 256, 256);
+      pad -= n;
+      written += n;
+    }
+  }
+  written += incoming;
+}
